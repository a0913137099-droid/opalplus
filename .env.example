# Server-only. Do not add VITE_ prefixes or commit real credentials.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Public OAuth client ID; credentials remain with Google.
GOOGLE_CLIENT_ID=

# Optional: exact HTTPS frontend origin behind a reverse proxy.
# Codespaces origins are inferred automatically.
PUBLIC_ORIGIN=
