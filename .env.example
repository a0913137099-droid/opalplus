# Production values belong in Sites runtime settings, not committed source.
# Required secret for the encrypted, 8-hour key setup session:
AI_SESSION_SECRET=
# Optional server defaults; disabled until explicitly enabled.
GEMINI_API_KEY=
AI_ENABLED=false
AI_IMAGES_ENABLED=false
AI_CALL_LIMIT=20
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
